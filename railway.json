{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "backend",
      "path": "backend",
      "buildCommand": "./mvnw clean install -DskipTests",
      "startCommand": "java -jar target/*.jar",
      "healthcheck": {
        "path": "/api/phim",
        "interval": 10,
        "timeout": 5,
        "retries": 10
      }
    },
    {
      "name": "frontend",
      "path": "frontend",
      "buildCommand": "npm install && npm run build",
      "startCommand": "npm run preview",
      "healthcheck": {
        "path": "/",
        "interval": 10,
        "timeout": 5,
        "retries": 5
      }
    }
  ]
}
